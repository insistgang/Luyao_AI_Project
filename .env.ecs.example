# Copy to .env.ecs. Keep the filled file private with chmod 600.
MINIMAX_API_KEY=
MINIMAX_API_HOST=https://api.minimaxi.com
MINIMAX_CHAT_MODEL=abab6.5s-chat
MINIMAX_VOICE_ID=luyao_voice_v1
MINIMAX_SPEECH_MODEL=speech-2.8-hd
MINIMAX_WHISPER_MODEL=speech-2.6-hd
LUYAO_ACCESS_USER=awu
LUYAO_ACCESS_PASSWORD=
LUYAO_REQUIRE_AUTH=true
LUYAO_ALLOW_PUBLIC=false
LUYAO_MEMORY_EXTRACTOR=true
# ALLOW_PUBLIC=true skips login. ALLOW_UNCONFIGURED=true also permits an empty API Key.
LUYAO_ALLOW_UNCONFIGURED=false
LUYAO_ROOT_PATH=/luyao
LUYAO_APT_MIRROR=http://mirrors.cloud.aliyuncs.com
LUYAO_PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
